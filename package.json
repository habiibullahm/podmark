{
  "name": "podmark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "typecheck": "npm run typecheck --workspaces && npm run typecheck:api",
    "typecheck:api": "tsc --project tsconfig.api.json",
    "lint": "oxlint",
    "test:e2e": "npm run test:e2e --workspace=frontend",
    "test:e2e:ui": "npm run test:e2e:ui --workspace=frontend"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vercel/node": "^12.0.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2"
  }
}
